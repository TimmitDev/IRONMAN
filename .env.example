# Kopieer naar .env.local en vul in (Supabase > Project Settings > API Keys)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optioneel: Strava-koppeling (strava.com/settings/api). Alleen het client ID; het secret hoort in Supabase.
VITE_STRAVA_CLIENT_ID=
